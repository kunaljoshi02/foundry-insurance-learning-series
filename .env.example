# Copy to .env and fill in your own sandbox values. Never commit the real .env file.

# Azure subscription/tenant to deploy the public learning foundation into.
AZURE_SUBSCRIPTION_ID=<your-subscription-id>
AZURE_TENANT_ID=<your-tenant-id>
AZURE_LOCATION=<azure-region e.g. eastus2>

# Resource naming (kept generic; scripts derive final names with a random suffix).
RESOURCE_GROUP_NAME=<your-resource-group-name>
FOUNDRY_ACCOUNT_NAME=<your-foundry-account-name>
FOUNDRY_PROJECT_NAME=<your-foundry-project-name>

# Chat model deployment used across modules (see foundation/bicep/main.bicepparam).
CHAT_MODEL_NAME=gpt-4o-mini
CHAT_MODEL_VERSION=<model-version>
CHAT_MODEL_CAPACITY=10

# Azure AI Search (module 03+)
SEARCH_SERVICE_NAME=<your-search-service-name>
SEARCH_INDEX_NAME=contoso-policy-wordings

# Optional: Application Insights connection string for observability modules.
APPINSIGHTS_CONNECTION_STRING=<your-app-insights-connection-string>

# Optional: APIM gateway (module 08 enterprise overlay only; disabled by default).
APIM_GATEWAY_URL=<your-apim-gateway-url>
ENABLE_ENTERPRISE_OVERLAY=false
